# ─────────────────────────────────────────────
# Postgres — read by BOTH docker-compose.yml and the app
# ─────────────────────────────────────────────
POSTGRES_USER=app_user
POSTGRES_PASSWORD=password
POSTGRES_DB=linkforge
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# The connection string sqlx/the app actually uses.
# (Assembled from the parts above; keep them in sync.)
DATABASE_URL=postgres://app_user:password@localhost:5432/linkforge

# Pool tuning (read by db/pool.rs)
DATABASE_MAX_CONNECTIONS=20
DATABASE_ACQUIRE_TIMEOUT_SECS=3
DATABASE_IDLE_TIMEOUT_SECS=3

# ─────────────────────────────────────────────
# Redis — for Phase 6
# ─────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
CACHE_NEGATIVE_TTL=30
# ─────────────────────────────────────────────
# Server
# ─────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=3000
APP_ENV=development

# ─────────────────────────────────────────────
# Observability (Phase 3)
# ─────────────────────────────────────────────
RUST_LOG=linkforge=info,tower_http=info,sqlx=warn
# RUST_LOG=off
# ─────────────────────────────────────────────
# Rate limiting (Phase 3)
# ─────────────────────────────────────────────
RATE_LIMIT_REQUESTS=100000000
RATE_LIMIT_WINDOW_SECS=60
RATE_LIMIT_SWEEP_INTERVAL_SECS=300
RATE_LIMIT_IDLE_TTL_SECS=3600
# ─────────────────────────────────────────────
# Auth / JWT (Phase 7) — change in production!
# ─────────────────────────────────────────────
JWT_SECRET=dev-only-change-me-in-production
JWT_EXPIRY_SECS=3600

#--------------------------------------------------
# Analytics Config
#--------------------------------------------------
ANALYTICS_CHANNEL_CAPACITY=10000
ANALYTICS_MAX_BATCH=500
ANALYTICS_BATCH_WAIT_MS=50
ANALYTICS_IP_SALT="FYFYGUIg7fyufG87fyu7vG87gf8YV8ug"
CLICK_MODE=async