# ─────────────────────────────────────────────
# Postgres: read by docker-compose.yml AND the app
# ─────────────────────────────────────────────
POSTGRES_USER=app_user
POSTGRES_PASSWORD=password
POSTGRES_DB=linkforge
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Connection string used by the app and sqlx-cli.
DATABASE_URL=postgres://app_user:password@localhost:5432/linkforge

# ─────────────────────────────────────────────
# Secrets
# ─────────────────────────────────────────────
ANALYTICS_IP_SALT="FYFYGUIg7fyufG87fyu7vG87gf8YV8ug"
JWT_SECRET=dev-only-change-me-in-production

# ─────────────────────────────────────────────
# Environment selection: picks configs/{APP_ENV}.toml
# ─────────────────────────────────────────────
APP_ENV=development

# ─────────────────────────────────────────────
# Logging: read by tracing's EnvFilter, not by figment
# ─────────────────────────────────────────────
RUST_LOG=linkforge=info,tower_http=info,sqlx=warn

# ─────────────────────────────────────────────
# Phase 6
# ─────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─────────────────────────────────────────────
# Per-run overrides go on the command line, not here:
#   LINKFORGE__RATE_LIMIT__REQUESTS=100000000 cargo run --release
#   LINKFORGE__ANALYTICS__CLICK_MODE=sync     cargo run --release
# ─────────────────────────────────────────────